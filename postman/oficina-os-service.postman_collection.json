{
  "info": {
    "name": "oficina-os-service",
    "description": "OS Service e orquestrador da saga (Fase 4). Defina a variável adminPassword (a mesma do ADMIN_PASSWORD do .env) e rode na ordem. Orçamento, pagamento e execução acontecem no billing-service e no execution-service; aqui se acompanha o estado e o histórico. Datas em Unix epoch ms.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "veiculoId",
      "value": ""
    },
    {
      "key": "servicoId",
      "value": ""
    },
    {
      "key": "pecaId",
      "value": ""
    },
    {
      "key": "osId",
      "value": ""
    },
    {
      "key": "osNumero",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 · Autenticação",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sem token → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 · Cadastros",
      "item": [
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"clienteId\", pm.response.json()[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar veículos do cliente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/veiculos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "veiculos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const v = pm.response.json().find(x => x.clienteId === pm.collectionVariables.get(\"clienteId\"));",
                  "pm.test(\"veículo do cliente\", () => pm.expect(v).to.exist);",
                  "pm.collectionVariables.set(\"veiculoId\", v.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar serviços",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/servicos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "servicos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"servicoId\", pm.response.json()[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar peças (estoque)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pecas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pecas"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"pecaId\", pm.response.json()[0].id);",
                  "pm.test(\"estoque numérico\", () => pm.expect(pm.response.json()[0].estoque).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 · Saga da OS",
      "item": [
        {
          "name": "Abrir OS (inicia a saga)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"veiculoId\": \"{{veiculoId}}\",\n  \"servicos\": [\n    {\n      \"servicoId\": \"{{servicoId}}\"\n    }\n  ],\n  \"pecas\": [\n    {\n      \"pecaId\": \"{{pecaId}}\",\n      \"quantidade\": 2\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "const os = pm.response.json();",
                  "pm.test(\"nasce RECEBIDA\", () => pm.expect(os.status).to.eql(\"RECEBIDA\"));",
                  "pm.test(\"datas em epoch ms\", () => pm.expect(os.datas.recebidaEm).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"osId\", os.id);",
                  "pm.collectionVariables.set(\"osNumero\", os.numero);"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalhe (estado da saga)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{osId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "{{osId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"tem bloco saga\", () => pm.expect(pm.response.json()).to.have.property(\"saga\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Histórico da OS",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{osId}}/historico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "{{osId}}",
                "historico"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"começa pela abertura\", () => pm.expect(pm.response.json()[0].evento).to.eql(\"OrdemServicoAberta\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consulta pública pelo número",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/publico/ordens-servico/{{osNumero}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "publico",
                "ordens-servico",
                "{{osNumero}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"sem dados internos\", () => pm.expect(pm.response.json()).to.not.have.property(\"clienteId\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar OSs em andamento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancelar (dispara compensações)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{osId}}/cancelar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "{{osId}}",
                "cancelar"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Cliente desistiu\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"CANCELADA\", () => pm.expect(pm.response.json().status).to.eql(\"CANCELADA\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancelar de novo → 400",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/{{osId}}/cancelar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "{{osId}}",
                "cancelar"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 · Validações",
      "item": [
        {
          "name": "OS sem itens → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"veiculoId\": \"{{veiculoId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "OS inexistente → 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens-servico/00000000-0000-4000-8000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens-servico",
                "00000000-0000-4000-8000-000000000000"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}