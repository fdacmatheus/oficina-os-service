# Copie para .env e ajuste. Nada aqui é segredo real: o repositório é público.
NODE_ENV=development
PORT=3001
LOG_FORMAT=text

# Postgres do os-service (fase-4/local/docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USER=os
DB_PASSWORD=os
DB_NAME=os
DB_SSL=false

# Mesmo segredo usado pelos outros serviços e pela Lambda de auth.
# Gere um local com: openssl rand -base64 48
JWT_SECRET=troque-me-local
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-me-local-refresh
JWT_REFRESH_EXPIRES_IN=7d

# Chave das rotas internas (/api/internos), usada pela Lambda de autenticação.
# Gere com: openssl rand -base64 32
INTERNAL_API_KEY=troque-me-local

AUTO_SEED=true
# Senha do usuário admin criado pelo seed (só ambiente local)
ADMIN_PASSWORD=troque-me-local

# AWS emulada pelo Floci. Na AWS real, remova AWS_ENDPOINT_URL e as chaves.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_OS_EVENTOS_URL=http://localhost:4566/000000000000/os-eventos
SQS_BILLING_COMANDOS_URL=http://localhost:4566/000000000000/billing-comandos
SQS_EXECUTION_COMANDOS_URL=http://localhost:4566/000000000000/execution-comandos
SQS_CONSUMER_ENABLED=true
OUTBOX_PUBLICADOR_ENABLED=true

# E-mail ao cliente (MailHog local, UI em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=oficina@oficina.com
